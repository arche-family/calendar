/// Calendar, the Arche phone's, written in Arche, as a phone's calendar is
/// (arche-os T7, T12): the month, 2026 / 11, its days from Monday on a
/// card, the weekend's blue, today filled, the day picked washed and a
/// dot on a day with events; ‹ and › go to the month before and after.
/// The day picked has its events under the card, in the order of their
/// times, each with Delete. + opens a new event's page: its title, its
/// day (the one picked), its time on steppers, whether to be reminded,
/// and ✓; ✕ and the phone's Back close it. Time is the shell's
/// (now-millis), as the user reads it (utc-offset). What it says is in
/// the phone's language (host_api's locale): English, Uzbek or Russian.
///
/// An app of the phone's world (arche:phone, wit/): an event to be
/// reminded of has the phone wake the app at its time (background's
/// wake-at), off the screen or asleep, and the app, woken, posts its
/// notification (notify's post): the time it asked for has come, whatever
/// its clock says. The phone wakes an app at one time, so the app asks for
/// the soonest, and again once woken. The events, up to when their
/// reminders were posted and the time it asked for, are kept in the app's
/// storage.
import alloc;
import appkit;
import background;
import dom;
import host_api;
import notify;
import std;

const SHEET: str = ".names { display: grid; grid-template-columns: repeat(7, 1fr); padding: 4px 8px 6px; } .name { font-size: 12px; font-weight: 500; color: var(--kit-muted); text-align: center; } .name.end { color: var(--kit-accent); } .monthcard { background: var(--kit-card); border-radius: 0 0 24px 24px; padding: 0 8px 14px; } .grid { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: 6px; } .blank { height: 48px; } button.day { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 48px; margin: 0 4px; padding: 0; border-radius: 14px; font-size: 18px; font-weight: 400; border: 0; background: transparent; color: var(--kit-text); } button.day.end { color: var(--kit-accent); } button.day.picked { background: var(--kit-wash); } button.day.today { background: var(--kit-accent); color: #ffffff; } .dot { width: 5px; height: 5px; border-radius: 3px; background: var(--kit-accent); margin-top: 3px; } .today .dot { background: #ffffff; } .when { font-size: 15px; font-weight: 500; color: var(--kit-muted); padding: 18px 28px 8px; } .events { display: flex; flex-direction: column; gap: 8px; padding: 0 16px 16px; } .event { display: flex; flex-direction: row; align-items: center; gap: 14px; padding: 14px 10px 14px 18px; border-radius: 18px; background: var(--kit-card); } .bar { width: 4px; height: 36px; border-radius: 2px; background: var(--kit-accent); } .etext { display: flex; flex-direction: column; gap: 2px; flex-grow: 1; } .what { font-size: 16px; color: var(--kit-text); } .at { font-size: 13px; color: var(--kit-muted); } .none { font-size: 15px; color: var(--kit-muted); text-align: center; padding: 40px 0; } .newpage .head .title { flex-grow: 1; } .newpage .group .row input { font-size: 17px; } .pick { display: flex; flex-direction: row; justify-content: center; align-items: center; gap: 8px; padding: 8px 0 12px; } .spin { display: flex; flex-direction: column; align-items: center; } .val { font-size: 44px; font-weight: 300; color: var(--kit-text); width: 80px; text-align: center; } .colon { font-size: 40px; font-weight: 300; color: var(--kit-muted); } .switch { width: 52px; height: 32px; border-radius: 16px; padding: 4px; display: flex; flex-direction: row; justify-content: flex-start; align-items: center; background: var(--kit-line); flex-shrink: 0; } .switch.on { justify-content: flex-end; background: var(--kit-accent); } .knob { width: 24px; height: 24px; border-radius: 12px; background: #ffffff; } .grow { flex-grow: 1; } .hidden { display: none; }";

const DAY_MINUTES: i64 = 1440;
const DAY_MS: i64 = 86400000;

/// The name of month m, 1 to 12.
fn month_name(m: i64) -> str {
    if m == 1 { return "January"; }
    if m == 2 { return "February"; }
    if m == 3 { return "March"; }
    if m == 4 { return "April"; }
    if m == 5 { return "May"; }
    if m == 6 { return "June"; }
    if m == 7 { return "July"; }
    if m == 8 { return "August"; }
    if m == 9 { return "September"; }
    if m == 10 { return "October"; }
    if m == 11 { return "November"; }
    return "December";
}

/// The name of the day of the week w, 0 for Monday.
fn weekday_name(w: i64) -> str {
    if w == 0 { return "Monday"; }
    if w == 1 { return "Tuesday"; }
    if w == 2 { return "Wednesday"; }
    if w == 3 { return "Thursday"; }
    if w == 4 { return "Friday"; }
    if w == 5 { return "Saturday"; }
    return "Sunday";
}

/// The phone's languages the app speaks.
const EN: u32 = 0;
const UZ: u32 = 1;
const RU: u32 = 2;

/// The days' names in Uzbek and Russian, from Monday, whole and short; and
/// the months', as a date says them after the day (in Russian, genitive).
const UZ_DAYS: str = "Dushanba Seshanba Chorshanba Payshanba Juma Shanba Yakshanba";
const RU_DAYS: str = "Понедельник Вторник Среда Четверг Пятница Суббота Воскресенье";
const UZ_SHORT: str = "Du Se Ch Pa Ju Sh Ya";
const RU_SHORT: str = "пн вт ср чт пт сб вс";
const UZ_MONTHS: str = "yanvar fevral mart aprel may iyun iyul avgust sentabr oktabr noyabr dekabr";
const RU_MONTHS: str = "января февраля марта апреля мая июня июля августа сентября октября ноября декабря";

/// The language of a locale as the phone says it ("uz-UZ"): English for
/// one the app does not speak.
fn lang_of(locale: str) -> u32 {
    if locale.starts_with("uz") {
        return UZ;
    }
    if locale.starts_with("ru") {
        return RU;
    }
    return EN;
}

/// s, said in English, in lang: s itself in English, and for what the app
/// has no words of.
fn say(lang: u32, s: str) -> str {
    if s.eq("MON") {
        if lang == UZ { return "DU"; }
        if lang == RU { return "ПН"; }
    }
    if s.eq("TUE") {
        if lang == UZ { return "SE"; }
        if lang == RU { return "ВТ"; }
    }
    if s.eq("WED") {
        if lang == UZ { return "CH"; }
        if lang == RU { return "СР"; }
    }
    if s.eq("THU") {
        if lang == UZ { return "PA"; }
        if lang == RU { return "ЧТ"; }
    }
    if s.eq("FRI") {
        if lang == UZ { return "JU"; }
        if lang == RU { return "ПТ"; }
    }
    if s.eq("SAT") {
        if lang == UZ { return "SH"; }
        if lang == RU { return "СБ"; }
    }
    if s.eq("SUN") {
        if lang == UZ { return "YA"; }
        if lang == RU { return "ВС"; }
    }
    if s.eq("Add event") {
        if lang == UZ { return "Tadbir qoʻshish"; }
        if lang == RU { return "Добавить событие"; }
    }
    if s.eq("Enter event title") {
        if lang == UZ { return "Tadbir nomini kiriting"; }
        if lang == RU { return "Введите название события"; }
    }
    if s.eq("Date") {
        if lang == UZ { return "Sana"; }
        if lang == RU { return "Дата"; }
    }
    if s.eq("Time") {
        if lang == UZ { return "Vaqt"; }
        if lang == RU { return "Время"; }
    }
    if s.eq("Reminder") {
        if lang == UZ { return "Eslatma"; }
        if lang == RU { return "Напоминание"; }
    }
    if s.eq("No events") {
        if lang == UZ { return "Tadbirlar yoʻq"; }
        if lang == RU { return "Нет событий"; }
    }
    if s.eq("No events today") {
        if lang == UZ { return "Bugun tadbirlar yoʻq"; }
        if lang == RU { return "Сегодня нет событий"; }
    }
    return s;
}

/// The n-th word of words, from 0.
fn nth_word(words: str, n: i64) -> str {
    let b = words.bytes();
    var at: usize = 0;
    var k: i64 = 0;
    while at < b.len() {
        var e = at;
        while e < b.len() and b[e] != ' ' {
            e += 1;
        }
        if k == n {
            return words[at..e];
        }
        k += 1;
        at = e + 1;
    }
    return "";
}

/// The day picked, as the page heads its events: "Tuesday, November 17",
/// "Seshanba, 17-noyabr", "Вторник, 17 ноября".
fn when_text(lang: u32, day: i64, out: &mut alloc.String) {
    let c = civil_of(day);
    if lang == UZ {
        out.push_str(nth_word(UZ_DAYS, n: weekday(day)));
        out.push_str(", ");
        out.push_i64(c.d);
        out.push_str("-");
        out.push_str(nth_word(UZ_MONTHS, n: c.m - 1));
    } else if lang == RU {
        out.push_str(nth_word(RU_DAYS, n: weekday(day)));
        out.push_str(", ");
        out.push_i64(c.d);
        out.push_str(" ");
        out.push_str(nth_word(RU_MONTHS, n: c.m - 1));
    } else {
        out.push_str(weekday_name(weekday(day)));
        out.push_str(", ");
        out.push_str(month_name(c.m));
        out.push_str(" ");
        out.push_i64(c.d);
    }
}

/// The day a new event is on, short: "Tue, Nov 17, 2026", "Se, 17-noyabr,
/// 2026", "вт, 17 ноября 2026".
fn on_day_text(lang: u32, day: i64, out: &mut alloc.String) {
    let c = civil_of(day);
    if lang == UZ {
        out.push_str(nth_word(UZ_SHORT, n: weekday(day)));
        out.push_str(", ");
        out.push_i64(c.d);
        out.push_str("-");
        out.push_str(nth_word(UZ_MONTHS, n: c.m - 1));
        out.push_str(", ");
    } else if lang == RU {
        out.push_str(nth_word(RU_SHORT, n: weekday(day)));
        out.push_str(", ");
        out.push_i64(c.d);
        out.push_str(" ");
        out.push_str(nth_word(RU_MONTHS, n: c.m - 1));
        out.push_str(" ");
    } else {
        out.push_str(weekday_name(weekday(day))[0..3]);
        out.push_str(", ");
        out.push_str(month_name(c.m)[0..3]);
        out.push_str(" ");
        out.push_i64(c.d);
        out.push_str(", ");
    }
    out.push_i64(c.y);
}

/// An event: its day, in days since 1970; its time, in minutes of the
/// day as the user reads it; whether to be reminded of it; its title.
type Event = struct {
    id: u64,
    day: i64,
    minute: i64,
    remind: bool,
    title: alloc.String,
}

type Calendar = struct {
    events: alloc.List(Event),
    next: u64,
    /// Up to when reminders have been posted, and the time the phone was
    /// asked to wake the app at (0 for none), ms since 1970.
    told: i64,
    wake: i64,
    /// The month shown, and the day picked.
    year: i64,
    month: i64,
    picked: i64,
    /// The new event: its title as typed, its time, whether to remind.
    title: alloc.String,
    at: i64,
    remind: bool,
    /// Whether the new event's page is up.
    adding: bool,
    /// The page's nodes.
    month_page: u32,
    new_page: u32,
    month_node: u32,
    grid: u32,
    when: u32,
    list: u32,
    field: u32,
    time: u32,
    hour_node: u32,
    minute_node: u32,
    date_node: u32,
    remind_node: u32,
    /// The phone's locale, as it was last read, and its language; the
    /// stylesheets added, to take back when the page is made again.
    locale: alloc.String,
    lang: u32,
    sheets: [2]u32,
}

/// A day of the calendar: its year, month (1 to 12) and day.
type Civil = struct {
    y: i64,
    m: i64,
    d: i64,
}

/// The day y-m-d, in days since 1970-01-01 (Howard Hinnant's
/// days_from_civil).
fn days_of(y: i64, m: i64, d: i64) -> i64 {
    var yy = y;
    if m <= 2 {
        yy -= 1;
    }
    var era = yy / 400;
    if yy < 0 and yy % 400 != 0 {
        era -= 1;
    }
    let yoe = yy - era * 400;
    var mp = m - 3;
    if m <= 2 {
        mp = m + 9;
    }
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    return era * 146097 + doe - 719468;
}

/// The day days since 1970-01-01 is (civil_from_days).
fn civil_of(days: i64) -> Civil {
    let z = days + 719468;
    var era = z / 146097;
    if z < 0 and z % 146097 != 0 {
        era -= 1;
    }
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    var m = mp + 3;
    if mp >= 10 {
        m = mp - 9;
    }
    var y = yoe + era * 400;
    if m <= 2 {
        y += 1;
    }
    return Civil { y: y, m: m, d: d };
}

/// The day of the week of days, 0 for Monday.
fn weekday(days: i64) -> i64 {
    var w = (days + 3) % 7;
    if w < 0 {
        w += 7;
    }
    return w;
}

/// n / d rounded down.
fn floor_div(n: i64, d: i64) -> i64 {
    var q = n / d;
    if n % d != 0 and n < 0 {
        q -= 1;
    }
    return q;
}

/// The day now is, as the user reads it.
fn today(host: &mut std.Host) -> i64 {
    return floor_div(n: host_api.now_millis(host) + offset_ms(host), d: DAY_MS);
}

fn offset_ms(host: &mut std.Host) -> i64 {
    return host_api.utc_offset(host) as i64 * 60000;
}

/// When e is, in ms since 1970.
fn at_ms(e: &Event, offset: i64) -> i64 {
    return (e.day * DAY_MINUTES + e.minute) * 60000 - offset;
}

fn init(host: &mut std.Host, a: alloc.Allocator) -> Calendar {
    let kit = appkit.css(a);
    let kit_sheet = dom.add_stylesheet(host, css: kit.view());
    let sheet = dom.add_stylesheet(host, css: SHEET);
    let root = dom.root(host);
    let locale = host_api.locale(host, a: a);
    let lang = lang_of(locale.view());
    var markup = alloc.String.from("<div class='app'><div class='monthpage'><div class='appbar'><div class='big month'></div><div class='actions'><button class='iconbtn' data-k='prev'><span class='icon'>chevron_left</span></button><button class='iconbtn' data-k='next'><span class='icon'>chevron_right</span></button><button class='iconbtn' data-k='new'><span class='icon'>add</span></button></div></div><div class='monthcard'><div class='names'>", a);
    // The days' names, from Monday; the weekend's blue.
    var w: i64 = 0;
    while w < 7 : (w += 1) {
        if w < 5 {
            markup.push_str("<div class='name'>");
        } else {
            markup.push_str("<div class='name end'>");
        }
        markup.push_str(say(lang, s: nth_word("MON TUE WED THU FRI SAT SUN", n: w)));
        markup.push_str("</div>");
    }
    markup.push_str("</div><div class='grid'></div></div><div class='when'></div><div class='events'></div></div><div class='newpage hidden'><div class='head'><button class='iconbtn' data-k='cancel'><span class='icon'>close</span></button><div class='title'></div><button class='iconbtn' data-k='add'><span class='icon'>check</span></button></div><div class='big'>");
    markup.push_str(say(lang, s: "Add event"));
    markup.push_str("</div><div class='group'><div class='row'><input class='title' placeholder='");
    markup.push_str(say(lang, s: "Enter event title"));
    markup.push_str("'></div></div><div class='group'><div class='row'><span class='primary grow'>");
    markup.push_str(say(lang, s: "Date"));
    markup.push_str("</span><span class='trail datev'></span></div><div class='row'><span class='primary grow'>");
    markup.push_str(say(lang, s: "Time"));
    markup.push_str("</span><span class='trail time'></span></div><div class='pick'><div class='spin'><button class='iconbtn' data-k='h+'><span class='icon'>expand_less</span></button><div class='val hourv'></div><button class='iconbtn' data-k='h-'><span class='icon'>expand_more</span></button></div><div class='colon'>:</div><div class='spin'><button class='iconbtn' data-k='m+'><span class='icon'>expand_less</span></button><div class='val minutev'></div><button class='iconbtn' data-k='m-'><span class='icon'>expand_more</span></button></div></div></div><div class='group'><button class='row' data-k='remind'><span class='primary grow'>");
    markup.push_str(say(lang, s: "Reminder"));
    markup.push_str("</span><span class='switch remind'><span class='knob'></span></span></button></div></div></div>");
    var why = alloc.String.init(a);
    if not dom.set_markup(host, item: root, markup: markup.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    let cal = first(host, selector: ".app", a: a);
    dom.listen(host, item: cal, kind: "click");
    dom.listen(host, item: cal, kind: "input");
    dom.listen(host, item: root, kind: "back");
    // A swipe turns the month, as HyperOS's calendar does (arche-os T12).
    dom.listen(host, item: cal, kind: "swipe");
    let now_day = today(host);
    let c = civil_of(now_day);
    var state = Calendar {
        events: alloc.List(Event).init(a),
        next: 1,
        told: host_api.now_millis(host),
        wake: 0,
        year: c.y,
        month: c.m,
        picked: now_day,
        title: alloc.String.init(a),
        at: 9 * 60,
        remind: true,
        adding: false,
        month_page: first(host, selector: ".monthpage", a: a),
        new_page: first(host, selector: ".newpage", a: a),
        month_node: first(host, selector: ".month", a: a),
        grid: first(host, selector: ".grid", a: a),
        when: first(host, selector: ".when", a: a),
        list: first(host, selector: ".events", a: a),
        field: first(host, selector: "input.title", a: a),
        time: first(host, selector: ".time", a: a),
        hour_node: first(host, selector: ".hourv", a: a),
        minute_node: first(host, selector: ".minutev", a: a),
        date_node: first(host, selector: ".datev", a: a),
        remind_node: first(host, selector: ".remind", a: a),
        locale: locale,
        lang: lang,
        sheets: [kit_sheet, sheet],
    };
    match host_api.storage_get(host, key: "events", a: a) {
        some(kept) => { load(&mut state, text: kept.view(), a: a); }
        none => { }
    }
    match host_api.storage_get(host, key: "times", a: a) {
        some(kept) => {
            let k = kept.view();
            state.told = number(k) as i64;
            var sp: usize = 0;
            while sp < k.len() and k.bytes()[sp] != ' ' {
                sp += 1;
            }
            if sp < k.len() {
                state.wake = number(k[sp + 1..k.len()]) as i64;
            }
        }
        none => { keep_times(&state, host: host, a: a); }
    }
    show(&mut state, host: host, a: a);
    return state;
}

fn update(state: &mut Calendar, host: &mut std.Host, a: alloc.Allocator) {
    // The phone's language changed: the page made again in it, as init
    // makes it, its stylesheets taken back first. What was on it is lost;
    // the events are kept.
    let locale = host_api.locale(host, a: a);
    if not locale.view().eq(state.locale.view()) {
        dom.remove_stylesheet(host, sheet: state.sheets[0]);
        dom.remove_stylesheet(host, sheet: state.sheets[1]);
        state.* = init(host, a: a);
    }
    if background.woken(host) {
        remind(state, host: host, a: a);
    }
    var changed = false;
    for e in dom.events(host, a: a).items() {
        if e.kind.view().eq("back") {
            press(state, host: host, key: "cancel", a: a);
            changed = true;
        } else if e.kind.view().eq("swipe") and not state.adding {
            if e.value.view().eq("left") {
                press(state, host: host, key: "next", a: a);
            } else {
                press(state, host: host, key: "prev", a: a);
            }
            changed = true;
        } else if e.kind.view().eq("click") {
            match key_of(host, n: e.target, a: a) {
                some(k) => {
                    press(state, host: host, key: k.view(), a: a);
                    changed = true;
                }
                none => { }
            }
        } else if e.kind.view().eq("input") and e.target == state.field {
            state.title = alloc.String.from(e.value.view(), a);
        }
    }
    if changed {
        show(state, host: host, a: a);
    }
}

fn press(state: &mut Calendar, host: &mut std.Host, key: str, a: alloc.Allocator) {
    if key.eq("prev") or key.eq("next") {
        var m = state.month - 1;
        if key.eq("prev") {
            m -= 1;
        } else {
            m += 1;
        }
        state.year += floor_div(n: m, d: 12);
        state.month = m - floor_div(n: m, d: 12) * 12 + 1;
    } else if key.starts_with("d:") {
        let s = key[2..key.len()];
        if s.starts_with("-") {
            state.picked = 0 - number(s[1..s.len()]) as i64;
        } else {
            state.picked = number(s) as i64;
        }
        let c = civil_of(state.picked);
        state.year = c.y;
        state.month = c.m;
    } else if key.eq("h+") or key.eq("h-") or key.eq("m+") or key.eq("m-") {
        var step: i64 = 15;
        if key.starts_with("h") {
            step = 60;
        }
        if key.bytes()[1] == '-' {
            step = DAY_MINUTES - step;
        }
        state.at = (state.at + step) % DAY_MINUTES;
    } else if key.eq("remind") {
        state.remind = not state.remind;
    } else if key.eq("new") {
        state.adding = true;
        dom.focus(host, item: state.field);
    } else if key.eq("cancel") {
        state.adding = false;
    } else if key.eq("add") {
        if state.title.len() == 0 {
            return;
        }
        state.adding = false;
        state.events.push(Event { id: state.next, day: state.picked, minute: state.at, remind: state.remind, title: alloc.String.from(state.title.view(), a) });
        state.next += 1;
        state.title = alloc.String.init(a);
        dom.set_attribute(host, item: state.field, name: "value", value_: "");
        save(state, host: host, a: a);
        schedule(state, host: host, a: a);
    } else if key.starts_with("x:") {
        let id = number(key[2..key.len()]);
        var kept = alloc.List(Event).init(a);
        for e in state.events.items() {
            if e.id != id {
                kept.push(Event { id: e.id, day: e.day, minute: e.minute, remind: e.remind, title: alloc.String.from(e.title.view(), a) });
            }
        }
        state.events = kept;
        save(state, host: host, a: a);
        schedule(state, host: host, a: a);
    }
}

/// Woken: the reminders whose time has come since the last were posted,
/// posted, the time the app asked to be woken at come too; then the phone
/// asked to wake the app for the next.
fn remind(state: &mut Calendar, host: &mut std.Host, a: alloc.Allocator) {
    var until = host_api.now_millis(host);
    if state.wake > until {
        until = state.wake;
    }
    let offset = offset_ms(host);
    for e in state.events.items() {
        let t = at_ms(e, offset: offset);
        if e.remind and t > state.told and t <= until {
            var text = alloc.String.init(a);
            minutes_text(&mut text, minutes: e.minute);
            _ = notify.post(host, title: e.title.view(), text: text.view());
        }
    }
    if until > state.told {
        state.told = until;
    }
    schedule(state, host: host, a: a);
}

/// The phone asked to wake the app at the soonest reminder to come; for
/// none, not to.
fn schedule(state: &mut Calendar, host: &mut std.Host, a: alloc.Allocator) {
    var from = host_api.now_millis(host);
    if state.told > from {
        from = state.told;
    }
    let offset = offset_ms(host);
    var soonest: i64 = 0;
    for e in state.events.items() {
        let t = at_ms(e, offset: offset);
        if e.remind and t > from and (soonest == 0 or t < soonest) {
            soonest = t;
        }
    }
    background.wake_at(host, at_millis: soonest);
    state.wake = soonest;
    keep_times(state, host: host, a: a);
}

/// The page as it is: the month and its grid, the day picked and its
/// events, and the new event's time and reminder.
fn show(state: &mut Calendar, host: &mut std.Host, a: alloc.Allocator) {
    // As a phone's calendar says it: 2026 / 11.
    var title = alloc.String.init(a);
    title.push_i64(state.year);
    title.push_str(" / ");
    title.push_i64(state.month);
    dom.set_text(host, item: state.month_node, text: title.view());
    dom.toggle_class(host, item: state.month_page, name: "hidden", on: state.adding);
    dom.toggle_class(host, item: state.new_page, name: "hidden", on: not state.adding);
    if state.adding {
        dom.set_attribute(host, item: dom.root(host), name: "data-back", value_: "1");
    } else {
        dom.remove_attribute(host, item: dom.root(host), name: "data-back");
    }
    // The month's days from its Monday's column; the weekend's blue,
    // today's filled, the day picked's washed, a dot on a day with events.
    let first_day = days_of(y: state.year, m: state.month, d: 1);
    let now_day = today(host);
    var cells = alloc.String.init(a);
    var k: i64 = 0;
    while k < weekday(first_day) : (k += 1) {
        cells.push_str("<div class='blank'></div>");
    }
    var day = first_day;
    while civil_of(day).m == state.month : (day += 1) {
        cells.push_str("<button class='day");
        if weekday(day) >= 5 {
            cells.push_str(" end");
        }
        if day == now_day {
            cells.push_str(" today");
        } else if day == state.picked {
            cells.push_str(" picked");
        }
        cells.push_str("' data-k='d:");
        cells.push_i64(day);
        cells.push_str("'><span>");
        cells.push_i64(civil_of(day).d);
        cells.push_str("</span>");
        if has_events(state, day: day) {
            cells.push_str("<span class='dot'></span>");
        }
        cells.push_str("</button>");
    }
    var why = alloc.String.init(a);
    if not dom.set_markup(host, item: state.grid, markup: cells.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
    // The day picked: its name, and its events by their times.
    var when = alloc.String.init(a);
    when_text(state.lang, day: state.picked, out: &mut when);
    dom.set_text(host, item: state.when, text: when.view());
    for old in dom.children(host, item: state.list, a: a).items() {
        dom.release(host, item: old.*);
    }
    var order = alloc.List(usize).init(a);
    var i: usize = 0;
    while i < state.events.len() : (i += 1) {
        if state.events.items()[i].day == state.picked {
            // Into order by time: back while the one before is later.
            order.push(i);
            var j = order.len() - 1;
            while j > 0 and state.events.items()[order.items()[j - 1]].minute > state.events.items()[order.items()[j]].minute : (j -= 1) {
                let t = order.items()[j];
                let before = order.items()[j - 1];
                order.items_mut()[j] = before;
                order.items_mut()[j - 1] = t;
            }
        }
    }
    if order.len() == 0 {
        var none_said = "No events";
        if state.picked == now_day {
            none_said = "No events today";
        }
        line(host, parent_: state.list, tag: "div", class: "none", text: say(state.lang, s: none_said), a: a);
    }
    for at in order.items() {
        let e = &state.events.items()[at.*];
        let row = dom.create_element(host, tag: "div");
        dom.set_attribute(host, item: row, name: "class", value_: "event");
        line(host, parent_: row, tag: "div", class: "bar", text: "", a: a);
        let text = dom.create_element(host, tag: "div");
        dom.set_attribute(host, item: text, name: "class", value_: "etext");
        line(host, parent_: text, tag: "div", class: "what", text: e.title.view(), a: a);
        var t = alloc.String.init(a);
        minutes_text(&mut t, minutes: e.minute);
        if e.remind {
            t.push_str(" · ");
            t.push_str(say(state.lang, s: "Reminder"));
        }
        line(host, parent_: text, tag: "div", class: "at", text: t.view(), a: a);
        dom.append_child(host, parent_: row, child: text);
        let x = dom.create_element(host, tag: "button");
        var k2 = alloc.String.from("x:", a);
        k2.push_u64(e.id);
        dom.set_attribute(host, item: x, name: "data-k", value_: k2.view());
        // Its icon, delete, in the icon font.
        dom.set_attribute(host, item: x, name: "class", value_: "iconbtn");
        line(host, parent_: x, tag: "span", class: "icon", text: "delete", a: a);
        dom.append_child(host, parent_: row, child: x);
        dom.append_child(host, parent_: state.list, child: row);
    }
    var at_text = alloc.String.init(a);
    minutes_text(&mut at_text, minutes: state.at);
    dom.set_text(host, item: state.time, text: at_text.view());
    var hh = alloc.String.init(a);
    two(&mut hh, n: state.at / 60);
    dom.set_text(host, item: state.hour_node, text: hh.view());
    var mm = alloc.String.init(a);
    two(&mut mm, n: state.at % 60);
    dom.set_text(host, item: state.minute_node, text: mm.view());
    // The day it is on: the one picked.
    var on_day = alloc.String.init(a);
    on_day_text(state.lang, day: state.picked, out: &mut on_day);
    dom.set_text(host, item: state.date_node, text: on_day.view());
    dom.toggle_class(host, item: state.remind_node, name: "on", on: state.remind);
}

/// Whether day has an event.
fn has_events(state: &Calendar, day: i64) -> bool {
    for e in state.events.items() {
        if e.day == day {
            return true;
        }
    }
    return false;
}

/// An element of tag and class with text, last under parent_.
fn line(host: &mut std.Host, parent_: u32, tag: str, class: str, text: str, a: alloc.Allocator) {
    let d = dom.create_element(host, tag: tag);
    dom.set_attribute(host, item: d, name: "class", value_: class);
    dom.set_text(host, item: d, text: text);
    dom.append_child(host, parent_: parent_, child: d);
}

/// Minutes of the day as "09:05".
fn minutes_text(out: &mut alloc.String, minutes: i64) {
    two(out, n: minutes / 60);
    out.push_str(":");
    two(out, n: minutes % 60);
}

fn two(out: &mut alloc.String, n: i64) {
    if n < 10 {
        out.push_str("0");
    }
    out.push_i64(n);
}

/// The events kept, a line each: number, day, minute, 1 or 0 for the
/// reminder, and the title, parted by tabs.
fn save(state: &Calendar, host: &mut std.Host, a: alloc.Allocator) {
    var text = alloc.String.init(a);
    for e in state.events.items() {
        text.push_u64(e.id);
        text.push_str("\t");
        text.push_i64(e.day);
        text.push_str("\t");
        text.push_i64(e.minute);
        if e.remind {
            text.push_str("\t1\t");
        } else {
            text.push_str("\t0\t");
        }
        // The title, its tabs and line ends spaces; whole runs between
        // them, so that any UTF-8 stays as it is.
        let t = e.title.view();
        var start: usize = 0;
        var k: usize = 0;
        while k < t.len() : (k += 1) {
            if t.bytes()[k] == '\t' or t.bytes()[k] == '\n' {
                text.push_str(t[start..k]);
                text.push_str(" ");
                start = k + 1;
            }
        }
        text.push_str(t[start..t.len()]);
        text.push_str("\n");
    }
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "events", value: text.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
}

/// Up to when reminders were posted, and the time the app asked to be
/// woken at, kept as "told wake".
fn keep_times(state: &Calendar, host: &mut std.Host, a: alloc.Allocator) {
    var text = alloc.String.init(a);
    text.push_i64(state.told);
    text.push_str(" ");
    text.push_i64(state.wake);
    var why = alloc.String.init(a);
    if not host_api.storage_set(host, key: "times", value: text.view(), why: &mut why, a: a) {
        host_api.log(host, msg: why.view());
    }
}

/// The events kept, from text, as save wrote it.
fn load(state: &mut Calendar, text: str, a: alloc.Allocator) {
    let b = text.bytes();
    var at: usize = 0;
    while at < b.len() {
        var end = at;
        while end < b.len() and b[end] != '\n' {
            end += 1;
        }
        let l = text[at..end];
        at = end + 1;
        var tabs: [4]usize = [0; 4];
        var n: usize = 0;
        var k: usize = 0;
        while k < l.len() and n < 4 : (k += 1) {
            if l.bytes()[k] == '\t' {
                tabs[n] = k;
                n += 1;
            }
        }
        if n < 4 {
            continue;
        }
        let id = number(l[0..tabs[0]]);
        let day_text = l[tabs[0] + 1..tabs[1]];
        var day = number(day_text) as i64;
        if day_text.starts_with("-") {
            day = 0 - number(day_text[1..day_text.len()]) as i64;
        }
        state.events.push(Event { id: id, day: day, minute: number(l[tabs[1] + 1..tabs[2]]) as i64, remind: l[tabs[2] + 1..tabs[3]].eq("1"), title: alloc.String.from(l[tabs[3] + 1..l.len()], a) });
        if id >= state.next {
            state.next = id + 1;
        }
    }
}

/// The number s begins with.
fn number(s: str) -> u64 {
    var n: u64 = 0;
    for c in s.bytes() {
        if c.* < '0' or c.* > '9' {
            break;
        }
        n = n * 10 + (c.* - '0') as u64;
    }
    return n;
}

/// The first node under the page that selector finds; 0 for none.
fn first(host: &mut std.Host, selector: str, a: alloc.Allocator) -> u32 {
    let found = dom.query_all(host, scope: dom.root(host), selector: selector, a: a);
    if found.len() == 0 {
        return 0;
    }
    return found.items()[0];
}

/// The key a click on n is: its data-k, or its nearest ancestor's.
fn key_of(host: &mut std.Host, n: u32, a: alloc.Allocator) -> ?alloc.String {
    var at = n;
    var hops: u32 = 0;
    while at != 0 and hops < 8 : (hops += 1) {
        match dom.get_attribute(host, item: at, name: "data-k", a: a) {
            some(k) => { return k; }
            none => { }
        }
        at = dom.parent(host, item: at) orelse 0;
    }
    return none;
}
